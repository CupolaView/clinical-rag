# Copy to .env and fill in locally. Never commit .env, and never hardcode the account ID.
AWS_REGION=us-west-2
AWS_PROFILE=default
S3_BUCKET=gaurav-mlops-us-west-2
S3_PREFIX=clinical-rag

# Bedrock models (smoke-tested in us-west-2 on Oct 26, 2026)
BEDROCK_LLM_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIMENSIONS=1024
BEDROCK_RERANK_MODEL_ID=cohere.rerank-v3-5:0

# pgvector (filled in once RDS exists)
PGHOST=
PGPORT=5432
PGDATABASE=clinical_rag
PGUSER=
PGPASSWORD=
